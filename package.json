{
  "name": "aftof",
  "version": "1.0.0",
  "private": true,
  "description": "Collect files from many folders into one",
  "main": "./out/main/index.js",
  "author": "Vladislav Bondarev (vladane)",
  "license": "MIT",
  "homepage": "https://github.com/vladane/aftof",
